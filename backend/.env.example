# Template minimo para desenvolvimento local e CI (nao commitar .env com secrets reais).
DATABASE_URL="mysql://root:root@127.0.0.1:3306/comunikapp"
ESTOQUE_DATABASE_URL="mysql://root:root@127.0.0.1:3306/comunikapp"
JWT_SECRET="dev-jwt-secret-minimo-32-caracteres-ci"
JWT_EXPIRES_IN="7d"
# Gestão: gere valores locais distintos com `openssl rand -base64 48` (nunca reutilizar JWT_SECRET).
ADMIN_JWT_SECRET="TROCAR_GERAR_COM_OPENSSL_RAND_BASE64_48"
ADMIN_TWO_FACTOR_ENCRYPTION_KEY="TROCAR_GERAR_COM_OPENSSL_RAND_BASE64_48"
ADMIN_DEPLOY_WEBHOOK_SECRET="TROCAR_GERAR_COM_OPENSSL_RAND_BASE64_48"
ADMIN_SESSION_TTL_MINUTES="480"
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
TZ=America/Sao_Paulo
# UAT: nome distinto para nao herdar o JWT de producao (Domain=.comunikapp.com.br).
# SESSION_COOKIE_NAME="comunikapp_session_uat"
FRONTEND_URL="http://localhost:3000"
APP_FRONTEND_URL="http://localhost:3000"
GESTAO_FRONTEND_URL="http://localhost:3000/gestao"
ENABLE_SWAGGER=false
ESTOQUE_INTERNAL_API_TOKEN="ci-estoque-internal-token-min-32-chars"

# Cloudflare for SaaS (opcional em local; obrigatório em prod para domínio próprio)
# CF_ZONE_ID=""
# CF_API_TOKEN=""
# CF_SAAS_CNAME_TARGET="customers.comunikapp.com.br"
